{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the app's commands only (the shared mesh-ui commands and the desktop ones). No plugin permission is granted to the page: dialogs and the browser are opened from Rust (pick_folder, pick_file, open_url), never from JS.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-status",
    "allow-members",
    "allow-services",
    "allow-init",
    "allow-join",
    "allow-invite",
    "allow-remove",
    "allow-set-info",
    "allow-set-tags-of",
    "allow-deploy-wasm-file",
    "allow-undeploy",
    "allow-purge",
    "allow-set-placement",
    "allow-set-outbound",
    "allow-set-limits",
    "allow-config-get",
    "allow-config-set",
    "allow-reset-identity",
    "allow-platform",
    "allow-logs-follow",
    "allow-probe",
    "allow-cancel-stream",
    "allow-deploy-static-dir",
    "allow-connection",
    "allow-locate-meshd",
    "allow-set-meshd-path",
    "allow-daemon-run-user",
    "allow-daemon-install",
    "allow-pick-folder",
    "allow-pick-file",
    "allow-open-url",
    "allow-default-device-name"
  ]
}
