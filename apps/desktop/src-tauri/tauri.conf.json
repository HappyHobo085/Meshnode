{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meshnode",
  "version": "0.1.0",
  "identifier": "net.meshnode.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Meshnode",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.39)"],
        "files": {
          "/usr/lib/systemd/system/meshnode.service": "packaging/linux/meshnode.service",
          "/usr/share/meshnode/packaged": "packaging/linux/packaged"
        },
        "preInstallScript": "packaging/linux/scripts/preinst.sh",
        "postInstallScript": "packaging/linux/scripts/postinst.sh",
        "preRemoveScript": "packaging/linux/scripts/prerm.sh",
        "postRemoveScript": "packaging/linux/scripts/postrm.sh"
      },
      "rpm": {
        "depends": ["libc.so.6(GLIBC_2.39)(64bit)"],
        "files": {
          "/usr/lib/systemd/system/meshnode.service": "packaging/linux/meshnode.service",
          "/usr/share/meshnode/packaged": "packaging/linux/packaged"
        },
        "preInstallScript": "packaging/linux/scripts/preinst.sh",
        "postInstallScript": "packaging/linux/scripts/postinst.sh",
        "preRemoveScript": "packaging/linux/scripts/prerm.sh",
        "postRemoveScript": "packaging/linux/scripts/postrm.sh"
      }
    }
  }
}
