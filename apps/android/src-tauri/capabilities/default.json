{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "The main window: the app's commands only (the shared mesh-ui commands and the Android ones) and the barcode scanner's scan and camera-permission commands (QR scan on Join). No core permission is needed: the page uses no core plugin (window, event, path, ...). The folder picker plugin is called from Rust only, never from JS.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-status",
    "allow-members",
    "allow-services",
    "allow-init",
    "allow-join",
    "allow-invite",
    "allow-remove",
    "allow-set-info",
    "allow-set-tags-of",
    "allow-deploy-wasm-file",
    "allow-undeploy",
    "allow-purge",
    "allow-set-placement",
    "allow-set-outbound",
    "allow-set-limits",
    "allow-config-get",
    "allow-config-set",
    "allow-reset-identity",
    "allow-platform",
    "allow-logs-follow",
    "allow-probe",
    "allow-cancel-stream",
    "allow-node-running",
    "allow-service-start",
    "allow-service-stop",
    "allow-power-policy-get",
    "allow-power-policy-set",
    "allow-pick-tree",
    "allow-pick-wasm",
    "allow-deploy-static-tree",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel",
    "barcode-scanner:allow-check-permissions",
    "barcode-scanner:allow-request-permissions"
  ]
}
