# Release signing for `apps/android/build-apk.sh --release`. Copy this file to
# apps/android/keystore.properties (gitignored), or anywhere outside the repo and point
# MESHNODE_KEYSTORE_PROPERTIES at it, then replace the placeholders. Never commit the copy.
#
# storeFile: an absolute path, ~/..., or a path relative to this file's directory.
# Back up the keystore: losing it means no more updates, only uninstall and data loss.
storeFile=~/.config/meshnode/release.jks
storePassword=CHANGE_ME
keyAlias=meshnode
keyPassword=CHANGE_ME
